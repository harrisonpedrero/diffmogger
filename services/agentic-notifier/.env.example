# Twilio credentials - real values belong in local .env only. Do not commit them.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=+15555555555
HUMAN_TO=+15555555555
HUMAN_CHANNEL=sms

# Prefer TWILIO_MESSAGING_SERVICE_SID when using a Twilio Messaging Service.
# If TWILIO_MESSAGING_SERVICE_SID is set, the notifier sends with
# messaging_service_sid and does not pass TWILIO_FROM. If it is empty, TWILIO_FROM
# is used as the sender.

# Optional WhatsApp mode examples:
# HUMAN_CHANNEL=whatsapp
# TWILIO_FROM=whatsapp:+14155238886
# HUMAN_TO=whatsapp:+15555555555

# Target project repo integration
TARGET_REPO_DIR=/absolute/path/to/target-project
TARGET_HUMAN_INBOX_PATH=/absolute/path/to/target-project/docs/HUMAN_INBOX.md
TARGET_HUMAN_REQUESTS_PATH=/absolute/path/to/target-project/docs/HUMAN_REQUESTS.md
TARGET_HUMAN_OUTBOX_PATH=/absolute/path/to/target-project/docs/HUMAN_OUTBOX.md
TARGET_HUMAN_ARCHIVE_PATH=/absolute/path/to/target-project/docs/HUMAN_RESPONSES_ARCHIVE.md

# Optional JSONL queues for users who prefer file queues in addition to Markdown.
# TARGET_QUEUE_DIR=/absolute/path/to/target-project/queue

# Local service ports
NOTIFIER_API_HOST=127.0.0.1
NOTIFIER_API_PORT=8765
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787

# Optional local API token. Default can be empty when API server is bound to 127.0.0.1 only.
LOCAL_NOTIFY_API_TOKEN=

# Public ngrok base URL used for Twilio webhook signature validation.
WEBHOOK_PUBLIC_BASE_URL=https://example.ngrok-free.app

# Runtime behavior. Keep true until you intentionally test a real outbound send.
DRY_RUN=true
