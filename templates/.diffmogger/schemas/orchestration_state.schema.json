{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffmogger.local/schemas/orchestration_state.schema.json",
  "title": "Diffmogger Canonical Orchestration State Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "authority",
    "status",
    "database",
    "projection",
    "contract",
    "counts",
    "recent_events",
    "execution_dag",
    "progress_model",
    "ready_dag_nodes",
    "blocked_dag_nodes",
    "active_dag_nodes",
    "codebase_graph_summary",
    "latest_graph_snapshot",
    "graph_refresh_mode",
    "graph_refresh_reason",
    "graph_inventory_digest",
    "graph_inventory_changed",
    "graph_inventory_added_count",
    "graph_inventory_deleted_count",
    "graph_inventory_structural_count",
    "stale_node_count",
    "indexed_file_count",
    "command_node_count",
    "test_node_count",
    "task_graph_summary",
    "ready_task_nodes",
    "blocked_task_nodes",
    "dependency_cycles",
    "impact_graph_summary",
    "active_task_code_impacts",
    "context_pack_preview",
    "top_impacted_nodes",
    "stale_context_warning",
    "stale_graph_warnings",
    "active_leases",
    "conflicting_leases",
    "lease_suggestions_for_next_action",
    "scheduling_candidates",
    "selected_candidate",
    "skipped_candidates",
    "selected_scheduler_candidate",
    "skipped_scheduler_candidates",
    "scheduler_fallback_used",
    "graph_signals_used",
    "lease_conflicts_considered",
    "proposed_execution_groups",
    "parallelization_summary",
    "blocked_parallel_candidates",
    "why_not_parallel",
    "scheduler_parallel_dry_run",
    "parallelism_budgets",
    "active_parallel_counts",
    "budget_exhaustion_reasons",
    "active_read_only_workers",
    "pending_worker_reports",
    "completed_worker_reports",
    "worker_finding_disposition_required",
    "scope_evidence_records",
    "accepted_scope_evidence_records",
    "scope_fanout_outcomes",
    "exhausted_scope_fanout_outcomes",
    "active_write_workers",
    "queued_worker_patches",
    "write_worker_conflicts",
    "lease_conflict_summary",
    "integration_backlog_from_parallel_workers",
    "worker_patch_integration_preflight",
    "active_validation_jobs",
    "validation_job_summary",
    "parallel_validation_available",
    "validation_budget_status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "const": "sqlite"
    },
    "status": {
      "type": "string"
    },
    "database": {
      "type": "object",
      "required": ["path", "exists", "sqlite_version", "journal_mode", "integrity_check"],
      "properties": {
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "sqlite_version": {"type": "string"},
        "user_version": {"type": "integer"},
        "journal_mode": {"type": "string"},
        "integrity_check": {"type": "string"},
        "application_id": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "projection": {
      "type": "object",
      "required": ["name", "path", "exists"],
      "properties": {
        "name": {"type": "string"},
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "updated_at": {"type": "string"},
        "payload_sha256": {"type": "string"},
        "event_id": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    },
    "projections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "contract": {
      "type": "object",
      "required": ["tables", "status_model", "canonical_runtime_state", "compatibility_surfaces"],
      "properties": {
        "tables": {
          "type": "array",
          "items": {"type": "string"},
          "contains": {"const": "events"}
        },
        "status_model": {
          "type": "array",
          "items": {"type": "string"},
          "contains": {"const": "ACTIVE"}
        },
        "canonical_runtime_state": {"type": "string"},
        "execution_dag_action_types": {
          "type": "array",
          "items": {"type": "string"}
        },
        "execution_dag_canonical_action_types": {
          "type": "array",
          "items": {"type": "string"}
        },
        "execution_dag_action_capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["permissions", "required_inputs", "outputs", "lease_behavior", "required_by_default", "optional_by_default"],
            "properties": {
              "permissions": {"type": "array", "items": {"type": "string"}},
              "required_inputs": {"type": "array", "items": {"type": "string"}},
              "outputs": {"type": "array", "items": {"type": "string"}},
              "lease_behavior": {"type": "string"},
              "required_by_default": {"type": "boolean"},
              "optional_by_default": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "execution_dag_legacy_action_aliases": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "execution_dag_dependency_kinds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "scheduler_stages": {
          "type": "array",
          "items": {"type": "string"}
        },
        "compatibility_surfaces": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    },
    "schema_migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "name", "applied_at", "status"],
        "properties": {
          "version": {"type": "integer"},
          "name": {"type": "string"},
          "applied_at": {"type": "string"},
          "checksum": {"type": "string"},
          "status": {"type": "string"},
          "details": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": true
      }
    },
    "invariant_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "ok", "detail"],
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string"},
          "ok": {"type": "boolean"},
          "detail": {"type": "string"},
          "failures": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": true}
          }
        },
        "additionalProperties": true
      }
    },
    "state_health_summary": {
      "type": "object",
      "required": ["status", "passed", "failed", "invariant_count"],
      "properties": {
        "status": {"type": "string"},
        "checked_at": {"type": "string"},
        "passed": {"type": "integer"},
        "failed": {"type": "integer"},
        "invariant_count": {"type": "integer"},
        "failed_invariants": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "last_event": {
      "type": "object",
      "additionalProperties": true
    },
    "last_checkpoint": {
      "type": "object",
      "additionalProperties": true
    },
    "recent_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "stream_id", "sequence", "event_type", "event_hash"],
        "properties": {
          "event_id": {"type": "integer"},
          "stream_id": {"type": "string"},
          "sequence": {"type": "integer"},
          "occurred_at": {"type": "string"},
          "event_type": {"type": "string"},
          "actor_role": {"type": "string"},
          "phase": {"type": "string"},
          "status": {"type": "string"},
          "task_id": {"type": "string"},
          "run_id": {"type": "string"},
          "event_hash": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "open_blockers": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "validations": {
      "type": "object",
      "additionalProperties": true
    },
    "execution_dag": {
      "type": "object",
      "required": ["schema_version", "authority", "projection", "digest", "node_count", "edge_count", "nodes", "edges", "ready_nodes", "blocked_nodes", "active_nodes"],
      "properties": {
        "schema_version": {"type": "integer"},
        "authority": {"const": "sqlite"},
        "projection": {"const": "execution_dag"},
        "digest": {"type": "string"},
        "node_count": {"type": "integer"},
        "edge_count": {"type": "integer"},
        "node_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "edge_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "status_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "task_id", "action_type", "status", "owner_role", "worktree", "patch", "confidence", "attempt_count", "created_at", "updated_at", "blocker_reason", "validation_receipt_refs"],
            "properties": {
              "node_id": {"type": "string"},
              "task_id": {"type": "string"},
              "action_type": {"type": "string"},
              "status": {"type": "string"},
              "owner_role": {"type": "string"},
              "worktree": {"type": "object", "additionalProperties": true},
              "patch": {"type": "object", "additionalProperties": true},
              "confidence": {"type": "number"},
              "attempt_count": {"type": "integer"},
              "created_at": {"type": "string"},
              "updated_at": {"type": "string"},
              "started_at": {"type": "string"},
              "finished_at": {"type": "string"},
              "blocker_reason": {"type": "string"},
              "validation_receipt_refs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["edge_id", "source", "target", "dependency_kind", "reason", "confidence", "dependency_mode"],
            "properties": {
              "edge_id": {"type": "string"},
              "source": {"type": "string"},
              "target": {"type": "string"},
              "dependency_kind": {"type": "string"},
              "reason": {"type": "string"},
              "confidence": {"type": "number"},
              "dependency_mode": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "ready_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "blocked_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "active_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "terminal_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "primary_progress_node": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "progress_model": {
      "type": "object",
      "additionalProperties": true
    },
    "ready_dag_nodes": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "blocked_dag_nodes": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "active_dag_nodes": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "scheduler_state": {
      "type": "object",
      "additionalProperties": true
    },
    "scheduler_machine": {
      "type": "object",
      "required": ["schema_version", "machine_version", "authority", "work_item", "current_stage", "stage_contract", "capability_manifest"],
      "properties": {
        "schema_version": {"type": "integer"},
        "machine_version": {"type": "integer"},
        "authority": {"const": "sqlite"},
        "current_stage": {"type": "string"},
        "stage_status": {"type": "string"},
        "owner_role": {"type": "string"},
        "work_item": {
          "type": "object",
          "required": ["id", "status", "current_stage", "stage_status", "owner_role", "capability_manifest_id", "validation_status", "continuation_token"],
          "properties": {
            "id": {"type": "string"},
            "status": {"type": "string"},
            "current_stage": {"type": "string"},
            "stage_status": {"type": "string"},
            "owner_role": {"type": "string"},
            "capability_manifest_id": {"type": "string"},
            "capability_manifest_version": {"type": "integer"},
            "validation_status": {"type": "string"},
            "continuation_token": {"type": "string"}
          },
          "additionalProperties": true
        },
        "stage_contract": {
          "type": "object",
          "additionalProperties": true
        },
        "stage_contracts": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "capability_manifest": {
          "type": "object",
          "additionalProperties": true
        },
        "stage_attempts": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "validation_receipts": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "policy": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "automation_control": {
      "type": "object",
      "required": ["schema_version", "authority", "control_id", "status"],
      "properties": {
        "schema_version": {"type": "integer"},
        "authority": {"const": "sqlite"},
        "control_id": {"type": "string"},
        "status": {"type": "string"},
        "horizon": {"type": "string"},
        "horizon_decision": {"type": "string"},
        "current_assessment": {"type": "string"},
        "best_next_milestone": {"type": "string"},
        "suggested_next_task": {"type": "string"},
        "known_issues": {"type": "array", "items": {"type": "string"}},
        "worker": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "capability_manifest": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "integer"},
        "manifest_id": {"type": "string"},
        "version": {"type": "integer"},
        "digest": {"type": "string"},
        "languages": {"type": "object", "additionalProperties": true},
        "commands": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "code_intelligence": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "integer"},
        "provider_availability": {"type": "object", "additionalProperties": true},
        "latest_codebase_snapshot_id": {"type": "string"},
        "fact_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "fact_count": {"type": "integer"},
        "diagnostic_count": {"type": "integer"},
        "latest_facts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "fallback": {"type": "string"}
      },
      "additionalProperties": true
    },
    "codebase_graph_summary": {
      "type": "object",
      "required": ["schema_version", "graph_namespace", "exists", "stale_node_count", "indexed_file_count", "command_node_count", "test_node_count"],
      "properties": {
        "schema_version": {"type": "integer"},
        "graph_namespace": {"const": "codebase"},
        "exists": {"type": "boolean"},
        "latest_snapshot_id": {"type": "string"},
        "latest_graph_snapshot": {"type": "object", "additionalProperties": true},
        "stale_node_count": {"type": "integer"},
        "indexed_file_count": {"type": "integer"},
        "command_node_count": {"type": "integer"},
        "test_node_count": {"type": "integer"},
        "graph_refresh_mode": {"type": "string"},
        "graph_refresh_reason": {"type": "string"},
        "graph_inventory_digest": {"type": "string"},
        "graph_inventory_changed": {"type": "boolean"},
        "graph_inventory_added_count": {"type": "integer"},
        "graph_inventory_deleted_count": {"type": "integer"},
        "graph_inventory_structural_count": {"type": "integer"},
        "indexed_path_count": {"type": "integer"},
        "indexed_paths_truncated": {"type": "boolean"},
        "indexed_path_sample": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "node_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "edge_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "file_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "symbol_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "ownership_edges": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "import_edges": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "latest_graph_snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {"type": "string"},
        "graph_namespace": {"const": "codebase"},
        "generated_at": {"type": "string"},
        "head_commit": {"type": "string"},
        "dirty_tracked_file_count": {"type": "integer"},
        "dirty_tracked_files_digest": {"type": "string"},
        "indexed_file_count": {"type": "integer"},
        "directory_node_count": {"type": "integer"},
        "command_node_count": {"type": "integer"},
        "test_node_count": {"type": "integer"},
        "stale_node_count": {"type": "integer"},
        "digest": {"type": "string"},
        "graph_inventory_digest": {"type": "string"},
        "indexed_path_count": {"type": "integer"},
        "indexed_paths_truncated": {"type": "boolean"},
        "node_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "edge_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "file_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "symbol_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "ownership_edges": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "import_edges": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "graph_refresh_mode": {"type": "string"},
    "graph_refresh_reason": {"type": "string"},
    "graph_inventory_digest": {"type": "string"},
    "graph_inventory_changed": {"type": "boolean"},
    "graph_inventory_added_count": {"type": "integer"},
    "graph_inventory_deleted_count": {"type": "integer"},
    "graph_inventory_structural_count": {"type": "integer"},
    "stale_node_count": {"type": "integer"},
    "indexed_file_count": {"type": "integer"},
    "command_node_count": {"type": "integer"},
    "test_node_count": {"type": "integer"},
    "task_graph_summary": {
      "type": "object",
      "required": ["schema_version", "graph_namespace", "exists", "ready_task_count", "blocked_task_count", "dependency_cycle_count"],
      "properties": {
        "schema_version": {"type": "integer"},
        "graph_namespace": {"const": "task"},
        "exists": {"type": "boolean"},
        "latest_snapshot_id": {"type": "string"},
        "latest_graph_snapshot": {"type": "object", "additionalProperties": true},
        "node_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "edge_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "ready_task_count": {"type": "integer"},
        "blocked_task_count": {"type": "integer"},
        "dependency_cycle_count": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "ready_task_nodes": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "blocked_task_nodes": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "dependency_cycles": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "impact_graph_summary": {
      "type": "object",
      "required": ["schema_version", "graph_namespace", "exists", "stale_node_count"],
      "properties": {
        "schema_version": {"type": "integer"},
        "graph_namespace": {"const": "impact"},
        "exists": {"type": "boolean"},
        "latest_snapshot_id": {"type": "string"},
        "latest_graph_snapshot": {"type": "object", "additionalProperties": true},
        "node_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "edge_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "stale_node_count": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "active_task_code_impacts": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "context_pack_preview": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "integer"},
        "graph_namespace": {"const": "impact"},
        "bounded": {"type": "boolean"},
        "max_items": {"type": "integer"},
        "item_count": {"type": "integer"},
        "items": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "stale_context_warning": {"type": "string"}
      },
      "additionalProperties": true
    },
    "top_impacted_nodes": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "stale_context_warning": {"type": "string"},
    "stale_graph_warnings": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "active_leases": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "conflicting_leases": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "lease_suggestions_for_next_action": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "scheduling_candidates": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "selected_candidate": {
      "type": "object",
      "additionalProperties": true
    },
    "skipped_candidates": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "selected_scheduler_candidate": {
      "type": "object",
      "additionalProperties": true
    },
    "skipped_scheduler_candidates": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "scheduler_fallback_used": {"type": "boolean"},
    "graph_signals_used": {
      "type": "object",
      "additionalProperties": true
    },
    "lease_conflicts_considered": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "legacy_result": {
      "type": "object",
      "additionalProperties": true
    },
    "proposed_execution_groups": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "parallelization_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "blocked_parallel_candidates": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "why_not_parallel": {
      "type": "object",
      "additionalProperties": true
    },
    "scheduler_parallel_dry_run": {
      "type": "object",
      "additionalProperties": true
